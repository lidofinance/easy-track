# Environment for the Foundry fork-based scenario suite (forge auto-loads .env).
#
# The suite forks a live network and drives the deployed sr/sm EVM-script factories
# through the full Easy Track motion lifecycle. Select the network with CHAIN; the
# matching RPC endpoint is read from <CHAIN>_RPC_URL.

# Which network to fork: "mainnet" | "hoodi"
CHAIN=hoodi

# Archive/full-node RPC endpoints (already present in the repo's own .env for Brownie).
MAINNET_RPC_URL=
HOODI_RPC_URL=
